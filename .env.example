# Copy this file to ".env" and fill in your real keys.
# ".env" is gitignored and will never be committed.
#
# Get a free Gemini key at https://aistudio.google.com/app/apikey
# Then add the SAME value in Netlify: Site settings -> Environment variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional analytics (PostHog free tier)
# If VITE_PUBLIC_POSTHOG_KEY is not set, analytics stays disabled safely.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional local override for sitemap generation.
# On Netlify, URL is injected automatically and used as base URL.
SITE_URL=
